<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>BlockTheSpotInstaller</AssemblyName>
    <ApplicationIcon>../../assets/blockthespot.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BlockTheSpot.Core/BlockTheSpot.Core.csproj" />
    <Resource Include="../../assets/blockthespot.png" Link="Assets/blockthespot.png" />
  </ItemGroup>
</Project>
